rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.memberUids;
    }

    function verifiedEmail() {
      let t = request.auth.token;
      return t.get('email_verified', false) == true && t.get('email', null) is string
        ? t.email.lower() : "";
    }
    function invitePath(fid, email) {
      return /databases/$(database)/documents/invites/$(fid + "_" + email);
    }
    // A profile the caller writes about themself: exactly {name, email}, email = verified email.
    function validOwnProfile(p) {
      return p is map
        && p.keys().hasOnly(['name', 'email'])
        && verifiedEmail() != ""
        && p.email == verifiedEmail()
        && p.name is string && p.name.size() <= 100;
    }
    // memberProfiles diff touches only the caller's key; if present afterwards it must be valid.
    function ownProfileOnly() {
      let after = request.resource.data.get('memberProfiles', {});
      let before = resource.data.get('memberProfiles', {});
      return after is map
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || validOwnProfile(after[request.auth.uid]));
    }
    // Joiner holds an unexpired invite for this family and consumes (deletes) it in the same batch.
    function consumesValidInvite(fid) {
      let path = invitePath(fid, verifiedEmail());
      return verifiedEmail() != ""
        && exists(path)
        && get(path).data.familyId == fid
        && get(path).data.createdAt > request.time - duration.value(14, 'd')
        && !existsAfter(path);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      allow create: if signedIn()
        && fid.matches('^[A-Za-z0-9]+$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          // owner: anything, but must stay a member and memberUids stays a list
          (request.auth.uid == resource.data.ownerUid
            && request.resource.data.memberUids is list
            && resource.data.ownerUid in request.resource.data.memberUids)
          // other member: name (string 1..60) + own profile only
          || (request.auth.uid in resource.data.memberUids
            && request.auth.uid != resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberProfiles'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
              || (request.resource.data.name is string
                && request.resource.data.name.size() >= 1
                && request.resource.data.name.size() <= 60))
            && ownProfileOnly())
          // invited user joining: add only self (+ own profile), consuming a valid invite
          || (!(request.auth.uid in resource.data.memberUids)
            && consumesValidInvite(fid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberProfiles'])
            && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
            && ownProfileOnly())
        );
      allow delete: if false;

      match /appointments/{id} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid) && request.resource.data.familyId == fid;
      }

      match /children/{cid} {
        allow read, write: if isMember(fid);

        match /allergies/{id} {
          allow read, write: if isMember(fid);
        }
        match /vaccineSeries/{id} {
          allow read, write: if isMember(fid);
        }
        match /vaccineDoses/{id} {
          allow read, delete: if isMember(fid);
          allow create, update: if isMember(fid)
            && request.resource.data.familyId == fid
            && request.resource.data.childId == cid;
        }
        match /illnesses/{id} {
          allow read, write: if isMember(fid);
        }
        match /visits/{id} {
          allow read, write: if isMember(fid);
        }
        match /medications/{id} {
          allow read, write: if isMember(fid);
        }
        match /temperatureLogs/{id} {
          allow read, write: if isMember(fid);
        }
        match /growth/{id} {
          allow read, write: if isMember(fid);
        }
      }
    }

    // Invite id = familyId + "_" + lowercased invitee email.
    match /invites/{inviteId} {
      function isInviteeOrInviter() {
        return signedIn()
          && (resource.data.email == verifiedEmail() || resource.data.invitedBy == request.auth.uid);
      }
      function validNewInvite() {
        let d = request.resource.data;
        let fam = get(/databases/$(database)/documents/families/$(d.familyId)).data;
        return d.keys().hasOnly(['familyId', 'familyName', 'invitedBy', 'inviterEmail', 'email', 'createdAt'])
          && d.keys().hasAll(['familyId', 'familyName', 'invitedBy', 'inviterEmail', 'email', 'createdAt'])
          && d.invitedBy == request.auth.uid
          && verifiedEmail() != ""
          && d.inviterEmail == verifiedEmail()
          && d.email is string
          && d.email == d.email.lower()
          && d.email.size() <= 254
          && d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
          && d.familyId is string
          && d.familyId.matches('^[A-Za-z0-9]+$')
          && inviteId == d.familyId + "_" + d.email
          && d.createdAt == request.time
          && fam.ownerUid == request.auth.uid
          && d.familyName == fam.name;
      }
      allow read: if isInviteeOrInviter();
      allow create: if signedIn() && validNewInvite();
      allow delete: if isInviteeOrInviter();
      allow update: if false;
    }
  }
}
